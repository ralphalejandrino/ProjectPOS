# TarsierPOS — environment template
# Copy to .env and fill in. The application will not start without
# DJANGO_SECRET_KEY and FERNET_KEY — there are deliberately no fallbacks.

# --- required ---------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Encrypts stored payment-gateway credentials (pos.fields.FernetEncryptedField).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this makes existing encrypted rows unreadable.
FERNET_KEY=

# --- deployment -------------------------------------------------------------
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False

# --- paths (absolute; created if absent) ------------------------------------
BACKUP_PATH=/var/backups/tarsierpos
LOG_FILE=/var/log/tarsierpos/app.log
