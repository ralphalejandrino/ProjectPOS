[Unit]
Description=TarsierPOS Gunicorn
After=network.target
# FIX-PENDING-17/19: crashloop ceiling (these are [Unit] directives, not
# [Service]). Without it, Restart=always + RestartSec=5 never reaches the
# default 5-in-10s window and a crashing gunicorn restarts forever (AUDIT-004).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
User=__DEPLOY_USER__
Group=www-data
WorkingDirectory=/home/__DEPLOY_USER__/TarsierPOS
# FLAG-069: --log-level warning suppresses gunicorn's info-level shutdown
# messages, which otherwise trigger a benign "reentrant call inside
# BufferedWriter" RuntimeError when SIGTERM interrupts a logging write on stop.
ExecStart=/home/__DEPLOY_USER__/TarsierPOS/venv/bin/gunicorn pos_config.wsgi:application --bind 127.0.0.1:9000 --workers 3 --timeout 60 --log-level warning
Restart=always
RestartSec=5
EnvironmentFile=/home/__DEPLOY_USER__/TarsierPOS/.env
ExecStopPost=/home/__DEPLOY_USER__/TarsierPOS/backup_db.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
