[Unit]
Description=TarsierPOS daily health summary
# Installed by scripts/install-ops-units.sh (substitutes __TARSIERPOS_DIR__ /
# __DEPLOY_USER__). Output goes to the journal under identifier tarsierpos-health:
#   journalctl -t tarsierpos-health --since today

[Service]
Type=oneshot
User=__DEPLOY_USER__
Environment=TARSIERPOS_DIR=__TARSIERPOS_DIR__
SyslogIdentifier=tarsierpos-health
ExecStart=__TARSIERPOS_DIR__/scripts/ops/daily-health.sh
